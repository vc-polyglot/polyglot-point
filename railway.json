{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @platform/lexipop-decision run build"
  },
  "deploy": {
    "startCommand": "node packages/lexipop-decision/dist/index.cjs",
    "restartPolicyType": "ON_FAILURE"
  }
}