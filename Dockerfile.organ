FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY packages/organ-project/package.json ./packages/organ-project/

RUN cd packages/organ-project && pnpm install

COPY packages/organ-project/ ./packages/organ-project/

RUN cd packages/organ-project && npx tsc backend/index.ts --outDir backend/dist --module nodenext --moduleResolution nodenext --esModuleInterop true --skipLibCheck true || true

ENV NODE_ENV=production
ENV PORT=3002

EXPOSE 3002

CMD ["node", "packages/organ-project/backend/dist/index.js"]
