FROM node:20-alpine

WORKDIR /app

COPY packages/organ-project/package.json ./

RUN npm install

COPY packages/organ-project/backend/ ./backend/
COPY packages/organ-project/public/ ./public/

RUN npx tsc backend/index.ts --outDir backend/dist --module nodenext --moduleResolution nodenext --esModuleInterop true --skipLibCheck true

ENV NODE_ENV=production
ENV PORT=3002

EXPOSE 3002

CMD ["node", "backend/dist/index.js"]
