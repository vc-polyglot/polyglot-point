{
    "name": "@platform/polyglot-point",
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "npx tsx watch backend/index.ts",
        "dev:client": "cd frontend && npm run dev",
        "build-client": "cd frontend && npm install && npm run build",
        "build-server": "esbuild backend/index.ts --platform=node --bundle --format=cjs --alias:@shared=./shared --alias:@platform/core=../../packages/core --external:ws --external:multer --external:pg --outfile=dist/server.cjs",
        "build": "shx rm -rf dist && npm run build-client && npm run build-server && shx mkdir -p dist/public && shx cp -r frontend/dist/* dist/public/",
        "start": "node dist/server.cjs",
        "db:start": "docker compose up -d",
        "db:stop": "docker compose down",
        "db:push": "npx drizzle-kit push",
        "db:studio": "npx drizzle-kit studio",
        "db:generate": "npx drizzle-kit generate",
        "test": "node scripts/check-adapter-only.mjs && node --test --import tsx tests\\\\engine\\\\runClaraEngine.test.ts",
        "check:adapter-only": "node scripts/check-adapter-only.mjs"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.3.0",
        "@capacitor/browser": "8.0.3",
        "@capacitor/cli": "^8.3.0",
        "@capacitor/core": "^8.3.0",
        "@daniele-rolli/capacitor-google-auth": "3.4.0-rc.6",
        "@google-cloud/text-to-speech": "^6.1.0",
        "@neondatabase/serverless": "^0.10.4",
        "@platform/core": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-tooltip": "^1.2.7",
        "@revenuecat/purchases-capacitor": "^13.1.0",
        "@revenuecat/purchases-capacitor-ui": "^13.1.0",
        "connect-redis": "^9.0.0",
        "cordova-plugin-purchase": "13.13.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.44.7",
        "drizzle-zod": "^0.8.2",
        "express": "^4.21.1",
        "express-session": "^1.18.2",
        "google-auth-library": "^10.6.2",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "openai": "^5.23.2",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.16.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sonner": "^2.0.6",
        "stripe": "^20.1.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.0.0",
        "ws": "^8.18.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/express-session": "^1.18.2",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/pg": "^8.16.0",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.0.0",
        "autoprefixer": "^10.4.0",
        "concurrently": "^9.2.1",
        "drizzle-kit": "^0.31.8",
        "esbuild": "^0.25.5",
        "postcss": "^8.4.0",
        "shx": "^0.3.4",
        "tsx": "^4.21.0",
        "vite": "^4.0.0"
    }
}