/* =========================================================
   POLYGLOT POINT Ã¢â‚¬â€ Chat V8 (CLEAN / FINAL)
   ========================================================= */

/* ---------- Layout base del chat ---------- */
.chat-layout {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: var(--pp-container);
  margin: 0 auto;
  padding: 0 2rem;
  gap: 0;
  min-height: 0;
  overflow: hidden;
}

.response-column {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ---------- Tarjeta blanca del chat ---------- */
.response-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 20px;

  box-shadow:
    0 8px 40px rgba(0, 0, 0, 0.10),
    0 2px 8px rgba(0, 0, 0, 0.05);

  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;

  /* --- SCROLL PATCH: fade SIN romper scrollbar --- */
  position: relative;
}

/* --- SCROLL PATCH: fades arriba/abajo sin mask-image --- */
.response-card::before,
.response-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 24px;
  pointer-events: none;
  z-index: 3;
}

.response-card::before {
  top: 0;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.95),
    rgba(255, 255, 255, 0)
  );
}

.response-card::after {
  bottom: 0;
  background: linear-gradient(
    to top,
    rgba(255, 255, 255, 0.95),
    rgba(255, 255, 255, 0)
  );
}

/* =========================================================
   ZONA DE SCROLL REAL DEL CHAT
   ========================================================= */
.response-content {
  flex: 1;
  min-height: 0;

  overflow-y: scroll;
  overflow-x: hidden;

  scrollbar-gutter: stable both-edges;

  padding: 1.5rem;
  padding-bottom: calc(
    0rem
    + var(--pp-footer-links-h)
    + var(--pp-footer-gap)
    + 2
  );

  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 1.25rem;
}

/* ---------- Estados ---------- */
.response-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.response-placeholder p {
  color: var(--pp-light);
  font-size: 1.0625rem;
  text-align: center;
  max-width: 320px;
  line-height: 1.6;
}

.onboarding-message {
  padding: 1.5rem;
}

/* ---------- AnimaciÃƒÂ³n de entrada ---------- */
@keyframes messageIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- Mensajes ---------- */
.message-pair {
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  animation: messageIn 0.3s ease-out;
}

.user-text {
  align-self: flex-end;
  background: var(--pp-gradient);
  color: white;
  padding: 0.875rem 1.125rem;
  border-radius: 18px 18px 4px 18px;
  max-width: 75%;
  font-size: 0.9375rem;
  line-height: 1.5;
  box-shadow: 0 2px 8px rgba(0, 115, 255, 0.20);
}

.clara-response {
  width: 100%;
  animation: messageIn 0.3s ease-out;
}

.clara-text {
  color: var(--pp-ink);
  padding: 0.5rem 0;
  font-size: 0.9375rem;
  line-height: 1.7;
}

/* ---------- Thinking ---------- */
.clara-thinking {
  display: flex;
  gap: 0.375rem;
  padding: 0.875rem 1.125rem;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 18px 18px 18px 4px;
  width: fit-content;
  border: 1px solid rgba(0, 0, 0, 0.03);
  animation: messageIn 0.25s ease-out;
}

.clara-thinking span {
  width: 7px;
  height: 7px;
  background: var(--pp-primary);
  border-radius: 50%;
  animation: thinking 1.4s infinite ease-in-out;
}

.clara-thinking span:nth-child(1) { animation-delay: -0.32s; }
.clara-thinking span:nth-child(2) { animation-delay: -0.16s; }

@keyframes thinking {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ---------- Error ---------- */
.error-state {
  text-align: center;
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.875rem;
}

.error-icon { font-size: 3.5rem; }

.error-state h3 {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--pp-ink);
}

.error-state p {
  color: var(--pp-muted);
  font-size: 0.9375rem;
  max-width: 360px;
  line-height: 1.5;
}

/* =========================================================
   MOBILE
   ========================================================= */
@media (max-width: 768px) {
  .chat-layout {
    padding: 0 1rem;
  }

  /* SCROLL (mobile): mantener scrollbar estable sin forzarla siempre visible */
  .response-content {
    flex: 1;
    min-height: 0;

    overflow-y: auto;
    overflow-x: hidden;

    /* evita “aparece y desaparece” por cambios de layout */
    scrollbar-gutter: stable;

    padding: .25rem;
    padding-bottom: calc(
      0rem
      + var(--pp-footer-links-h)
      + var(--pp-footer-gap)
      + 2px
    );
  }

  .user-text {
    max-width: 88%;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    margin: 0 !important;
  }

  .clara-text {
    font-size: 0.9rem;
    margin: 0 !important;
  }

  .clara-response p {
    margin: 0 !important;
  }
}
