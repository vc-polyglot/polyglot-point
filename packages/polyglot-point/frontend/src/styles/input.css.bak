.input-fixed { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; padding: 1rem 2rem 1.5rem; max-width: var(--pp-container); margin: 0 auto; width: 100%; box-sizing: border-box; }
.input-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 24px; padding: 1rem 1.25rem; box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06); }
.input-card textarea { width: 100%; min-height: 56px; max-height: 150px; border: none; background: transparent; padding: 0.5rem 0; font-size: 1rem; font-family: var(--pp-font); color: var(--pp-ink); resize: none; outline: none; line-height: 1.5; }
.input-card textarea::placeholder { color: var(--pp-light); }
.input-card textarea:disabled { opacity: 0.5; cursor: not-allowed; }
.input-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; }
.input-left { display: flex; align-items: center; }
.char-count { font-size: 0.8125rem; color: var(--pp-light); font-weight: 500; }
.char-count.warning { color: var(--pp-warning); font-weight: 600; }
.footer-links-inline { display: none; }
.btn-send { width: 44px; height: 44px; border-radius: 50%; background: #e2e8f0; color: var(--pp-light); border: none; cursor: not-allowed; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.btn-send.active { background: var(--pp-gradient); color: white; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 115, 255, 0.3); }
.btn-send.active:hover { transform: scale(1.05); }
.btn-send svg { width: 20px; height: 20px; }
.footer-links-fixed { position: fixed; bottom: 0.5rem; left: 2rem; z-index: 50; display: flex; gap: 1rem; }
.footer-links-fixed a { font-size: 0.75rem; color: var(--pp-light); text-decoration: none; }
.footer-links-fixed a:hover { color: var(--pp-primary); }
@media (max-width: 768px) { .input-fixed { padding: 0.75rem 1rem 1rem; } .input-card { padding: 0.875rem 1rem; } .footer-links-fixed { left: 1rem; } }



