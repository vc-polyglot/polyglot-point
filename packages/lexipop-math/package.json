{
  "name": "@platform/lexipop-math",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":             "tsx backend/index.ts",
    "build":           "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend":  "cd frontend && vite build",
    "build:backend":   "tsup backend/index.ts --format cjs --out-dir dist --no-splitting --external vite",
    "start":           "node dist/index.cjs",
    "db:generate":     "drizzle-kit generate",
    "db:migrate":      "drizzle-kit migrate",
    "db:push":         "drizzle-kit push",
    "db:studio":       "drizzle-kit studio"
  },
  "dependencies": {
    "@lexipop/core":           "workspace:*",
    "@platform/core":          "workspace:*",
    "connect-redis":           "^7.1.1",
    "cors":                    "^2.8.5",
    "dotenv":                  "^16.4.5",
    "drizzle-orm":             "^0.33.0",
    "express":                 "^4.21.1",
    "express-session":         "^1.18.1",
    "passport":                "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg":                      "^8.13.0",
    "react":                   "^18.3.0",
    "react-dom":               "^18.3.0",
    "redis":                   "^4.7.0"
  },
  "devDependencies": {
    "@types/cors":                    "^2.8.17",
    "@types/express":                 "^4.17.21",
    "@types/express-session":         "^1.18.0",
    "@types/node":                    "^22.0.0",
    "@types/passport":                "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg":                      "^8.11.6",
    "@types/react":                   "^18.3.0",
    "@types/react-dom":               "^18.3.0",
    "@vitejs/plugin-react":           "^4.3.0",
    "drizzle-kit":                    "^0.24.0",
    "tsup":                           "^8.2.4",
    "tsx":                            "^4.16.2",
    "typescript":                     "^5.5.4",
    "vite":                           "^5.4.0"
  }
}