{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "lib":              ["ES2022"],
    "outDir":           "./dist",
    "rootDir":          ".",
    "strict":           true,
    "skipLibCheck":     true,
    "esModuleInterop":  true,
    "resolveJsonModule":true,
    "declaration":      false,
    "sourceMap":        true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["backend/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}